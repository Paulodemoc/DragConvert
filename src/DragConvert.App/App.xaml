<Application x:Class="DragConvert.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Theme/Tokens.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- The icon is set in code so it can follow the taskbar's light/dark theme. -->
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="DragConvert" NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open DragConvert" FontWeight="SemiBold" Click="OnOpenClick" />
                    <MenuItem Header="Settings…" Click="OnSettingsClick" />
                    <MenuItem x:Name="PauseItem" Header="Pause drag overlay" IsCheckable="True" Click="OnPauseClick" />
                    <Separator />
                    <MenuItem Header="Open log folder" Click="OnOpenLogFolderClick" />
                    <MenuItem Header="Quit" Click="OnQuitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
