<Application x:Class="DragConvert.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Placeholder icon until the real monochrome tray icon lands in M3. -->
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="DragConvert" NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="D" Foreground="White" Background="#FF2563EB" FontSize="36" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RendererItem" Header="Renderer" IsEnabled="False" />
                    <MenuItem Header="Open log folder" Click="OnOpenLogFolderClick" />
                    <Separator />
                    <MenuItem Header="Quit" Click="OnQuitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
