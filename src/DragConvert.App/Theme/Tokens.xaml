<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Design tokens: the single place for sizes, radii, timings and colours.
        Change the look here, not with numbers scattered through the code.
    -->

    <!-- Geometry (device-independent pixels) -->
    <sys:Double x:Key="Overlay.TileSize">60</sys:Double>
    <sys:Double x:Key="Overlay.DeadZoneRadius">44</sys:Double>
    <sys:Double x:Key="Overlay.Gap">8</sys:Double>
    <sys:Double x:Key="Overlay.TileRadius">10</sys:Double>
    <sys:Double x:Key="Overlay.PlatePadding">10</sys:Double>
    <sys:Double x:Key="Overlay.BadgeSize">56</sys:Double>
    <sys:Double x:Key="Overlay.BubbleSize">48</sys:Double>
    <sys:Double x:Key="Overlay.CaptionHeight">32</sys:Double>
    <sys:Double x:Key="Overlay.GlyphSize">18</sys:Double>
    <sys:Double x:Key="Overlay.LabelSize">12</sys:Double>
    <sys:Double x:Key="Overlay.DetailSize">10</sys:Double>
    <sys:Double x:Key="Overlay.CaptionSize">12</sys:Double>

    <!-- Motion (milliseconds); all skipped when Windows animations are off -->
    <sys:Double x:Key="Motion.ShowMs">140</sys:Double>
    <sys:Double x:Key="Motion.ShowFromScale">0.92</sys:Double>
    <sys:Double x:Key="Motion.TileStaggerMs">15</sys:Double>
    <sys:Double x:Key="Motion.HoverMs">100</sys:Double>
    <sys:Double x:Key="Motion.HoverScale">1.06</sys:Double>
    <sys:Double x:Key="Motion.CollapseMs">120</sys:Double>
    <sys:Double x:Key="Motion.HideMs">100</sys:Double>
    <sys:Double x:Key="Motion.ResultHoldMs">700</sys:Double>

    <!-- Fonts: system fonts, used at runtime and never bundled -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Small">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Glass style: brand blue regardless of light/dark, like the app icon -->
    <sys:Double x:Key="Glass.BubbleSize">56</sys:Double>
    <sys:Double x:Key="Glass.LabelHeight">30</sys:Double>
    <sys:Double x:Key="Glass.InnerRadius">62</sys:Double>
    <sys:Double x:Key="Glass.Gap">10</sys:Double>
    <sys:Double x:Key="Glass.RimPadding">12</sys:Double>
    <sys:Double x:Key="Glass.CenterGlyphSize">46</sys:Double>
    <sys:Double x:Key="Glass.BubbleGlyphSize">22</sys:Double>
    <sys:Double x:Key="Glass.HoverScale">1.08</sys:Double>
    <!-- Tint alphas: lighter over real acrylic blur, stronger when there's no blur behind (Windows 10, snapshots) -->
    <sys:Double x:Key="Glass.TintOverBlur">0.55</sys:Double>
    <sys:Double x:Key="Glass.TintNoBlur">0.88</sys:Double>
    <Color x:Key="Glass.Light">#FF6FAAFF</Color>
    <Color x:Key="Glass.Mid">#FF2F72E6</Color>
    <Color x:Key="Glass.Deep">#FF1648B8</Color>
    <Color x:Key="Glass.Inner">#FF123C9C</Color>
    <Color x:Key="Glass.Badge">#FF2B7BFF</Color>
    <Color x:Key="Glass.HoverIcon">#FF1F5FE0</Color>

    <!-- Dark theme -->
    <Color x:Key="Dark.Plate">#D91C1C1C</Color>
    <Color x:Key="Dark.PlateBorder">#33FFFFFF</Color>
    <Color x:Key="Dark.Tile">#FF2D2D2D</Color>
    <Color x:Key="Dark.TileBorder">#1FFFFFFF</Color>
    <Color x:Key="Dark.Text">#FFFFFFFF</Color>
    <Color x:Key="Dark.TextSecondary">#C5FFFFFF</Color>
    <Color x:Key="Dark.Caption">#F0202020</Color>
    <Color x:Key="Dark.Success">#FF6CCB5F</Color>
    <Color x:Key="Dark.Failure">#FFFF99A4</Color>

    <!-- Light theme -->
    <Color x:Key="Light.Plate">#E6F3F3F3</Color>
    <Color x:Key="Light.PlateBorder">#1A000000</Color>
    <Color x:Key="Light.Tile">#FFFFFFFF</Color>
    <Color x:Key="Light.TileBorder">#14000000</Color>
    <Color x:Key="Light.Text">#FF1A1A1A</Color>
    <Color x:Key="Light.TextSecondary">#FF5C5C5C</Color>
    <Color x:Key="Light.Caption">#F5FAFAFA</Color>
    <Color x:Key="Light.Success">#FF0F7B0F</Color>
    <Color x:Key="Light.Failure">#FFC42B1C</Color>
</ResourceDictionary>
