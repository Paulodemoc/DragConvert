<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ API surface for WinRT toast notifications; Windows 10 22H2 and Windows 11 are the targets. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- WPF's Fluent ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <AssemblyName>DragConvert</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from assets/icon-source/app.png (see Theme/AppIcon.cs). -->
    <ApplicationIcon>Assets\DragConvert.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DragConvert.ico" />
    <Resource Include="Assets\Tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DragConvert.Core\DragConvert.Core.csproj" />
    <ProjectReference Include="..\DragConvert.Providers\DragConvert.Providers.csproj" />
    <ProjectReference Include="..\DragConvert.Native\DragConvert.Native.csproj" />
  </ItemGroup>

</Project>
