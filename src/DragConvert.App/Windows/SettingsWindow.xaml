<Window x:Class="DragConvert.App.Windows.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragConvert settings"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Drag overlay" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Hold these keys while dragging files to show the overlay:" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ComboBox x:Name="TriggerBox" SelectionChanged="OnChanged" Margin="0,0,0,8" AutomationProperties.Name="Trigger keys">
            <ComboBoxItem Content="Ctrl + Shift" Tag="Control, Shift" />
            <ComboBoxItem Content="Ctrl + Alt" Tag="Control, Alt" />
            <ComboBoxItem Content="Shift + Alt" Tag="Shift, Alt" />
            <ComboBoxItem Content="Off (tray window and Send To only)" Tag="None" />
        </ComboBox>
        <TextBlock Text="Overlay style:" TextWrapping="Wrap" Margin="0,4,0,4" />
        <ComboBox x:Name="RendererBox" SelectionChanged="OnChanged" Margin="0,0,0,16" AutomationProperties.Name="Overlay style">
            <ComboBoxItem Content="Glass" Tag="glass" />
            <ComboBoxItem Content="Segments" Tag="segments" />
            <ComboBoxItem Content="Ring" Tag="layered" />
        </ComboBox>

        <TextBlock Text="Output" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <RadioButton x:Name="SameFolderRadio" Content="Save beside the original file" GroupName="Output" Checked="OnChanged" Margin="0,0,0,4" />
        <RadioButton x:Name="FixedFolderRadio" Content="Save everything to this folder:" GroupName="Output" Checked="OnChanged" Margin="0,0,0,4" />
        <Grid Margin="24,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" IsReadOnly="True" AutomationProperties.Name="Output folder" />
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Padding="10,4" Click="OnBrowseClick" />
        </Grid>

        <TextBlock Text="Windows" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="StartupCheck" Content="Start DragConvert when I sign in" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,6" />
        <CheckBox x:Name="SendToCheck" Content="Add &quot;DragConvert&quot; to the Send to menu" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,16" />

        <Grid>
            <TextBlock x:Name="VersionText" Opacity="0.75" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open log folder" Padding="10,4" Click="OnLogsClick" />
                <Button Content="Close" Padding="16,4" Margin="6,0,0,0" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
