<Window x:Class="DragConvert.App.Windows.PickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragConvert"
        Width="400"
        SizeToContent="Height"
        MaxHeight="680"
        ResizeMode="CanMinimize"
        ThemeMode="System"
        AllowDrop="True"
        ShowInTaskbar="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Drop zone; also shows the files handed over by Send To or a drop. -->
            <Grid x:Name="DropZone" MinHeight="96" Margin="0,0,0,12">
                <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4 3"
                           Stroke="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Fill="Transparent" />
                <StackPanel VerticalAlignment="Center" Margin="16,12">
                    <TextBlock x:Name="DropTitle" Text="Drop files or folders here" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="DropDetail" Text="Or drag with Ctrl+Shift held anywhere to convert in place."
                               Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Target formats for the current files. -->
            <StackPanel x:Name="TargetsPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Convert to" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl x:Name="Targets">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,6,6" MinWidth="80" Padding="10,6" Click="OnTargetClick" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,4" Click="OnClearClick" />
            </StackPanel>

            <!-- Recent conversions. -->
            <TextBlock x:Name="RecentHeader" Text="Recent" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="RecentEmpty" Text="Nothing converted yet." Opacity="0.75" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputPath}" />
                            <Button Grid.Column="1" Content="Open" Padding="8,2" Margin="6,0,0,0" Click="OnOpenRecentClick" Tag="{Binding}" />
                            <Button Grid.Column="2" Content="Show" Padding="8,2" Margin="6,0,0,0" Click="OnRevealRecentClick" Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
